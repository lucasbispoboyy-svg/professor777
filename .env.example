# Copie para .env e ajuste. Na primeira execução o .env é criado sozinho com o login do admin.

# Login do administrador (criado na primeira vez que o servidor sobe)
ADMIN_EMAIL=admin@painel.local
ADMIN_PASSWORD=troque-esta-senha

# Nome que aparece no painel
NOME_SAAS=AlugaLoja

# Porta do servidor
PORT=3000

# Domínio principal. Lojas ficam em <loja>.BASE_DOMAIN
# Local: localhost  ->  painel em http://localhost:3000 e lojas em http://minhaloja.localhost:3000
# Produção: seudominio.com.br (com DNS curinga *.seudominio.com.br apontando para o servidor)
BASE_DOMAIN=localhost

# Em produção, atrás do Caddy/Nginx com HTTPS:
# PUBLIC_PROTO=https
# PUBLIC_PORT=
# TRUST_PROXY=1

# Cobrança do aluguel pelo Asaas (Pix, boleto e cartão). Sem chave = modo teste.
# ASAAS_API_KEY=
# ASAAS_ENV=sandbox      # ou: producao
# ASAAS_WEBHOOK_TOKEN=   # o mesmo token configurado no webhook do Asaas
